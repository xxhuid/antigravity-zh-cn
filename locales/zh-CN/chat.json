  "patterns": [
    {
      "regex": "^(\\d+)\\s+files?\\s+changed$",
      "flags": "i",
      "replace": "$1 个文件已变更"
    },
    {
      "regex": "^(\\d+)\\s+seconds?\\s+ago$",
      "flags": "i",
      "replace": "$1 秒前"
    },
    {
      "regex": "^(\\d+)\\s+minutes?\\s+ago$",
      "flags": "i",
      "replace": "$1 分钟前"
    },
    {
      "regex": "^(\\d+)\\s+hours?\\s+ago$",
      "flags": "i",
      "replace": "$1 小时前"
    },
    {
      "regex": "^(\\d+)\\s+days?\\s+ago$",
      "flags": "i",
      "replace": "$1 天前"
    },
    {
      "regex": "^(\\d+)s\\s+ago$",
      "flags": "i",
      "replace": "$1 秒前"
    },
    {
      "regex": "^(\\d+)m\\s+ago$",
      "flags": "i",
      "replace": "$1 分钟前"
    },
    {
      "regex": "^(\\d+)h\\s+ago$",
      "flags": "i",
      "replace": "$1 小时前"
    },
    {
      "regex": "^(\\d+)d\\s+ago$",
      "flags": "i",
      "replace": "$1 天前"
    },
    {
      "regex": "^(\\d+)m$",
      "flags": "",
      "replace": "$1分钟"
    },
    {
      "regex": "^(\\d+)h$",
      "flags": "",
      "replace": "$1小时"
    },
    {
      "regex": "^(\\d+)d$",
      "flags": "",
      "replace": "$1天"
    },
    {
      "regex": "^(\\d+)\\s+tasks?\\s+running$",
      "flags": "i",
      "replace": "$1 个任务运行中"
    },
    {
      "regex": "^(\\d+)\\s+of\\s+(\\d+)\\s+completed$",
      "flags": "i",
      "replace": "已完成 $1 / $2"
    },
    {
      "regex": "^Good to see you,\\s*(.+?)\\.\\s*What's next\\?$",
      "flags": "",
      "replace": "很高兴见到你，$1。接下来做什么？"
    },
    {
      "regex": "^Welcome back,\\s*(.+?)\\.?$",
      "flags": "",
      "replace": "欢迎回来，$1。"
    },
    {
      "regex": "^Good morning,\\s*(.+?)\\.?$",
      "flags": "",
      "replace": "早上好，$1。"
    },
    {
      "regex": "^Good afternoon,\\s*(.+?)\\.?$",
      "flags": "",
      "replace": "下午好，$1。"
    },
    {
      "regex": "^Good evening,\\s*(.+?)\\.?$",
      "flags": "",
      "replace": "晚上好，$1。"
    }
  ]
